{
  "info": {
    "name": "VetRDV - Appointment Service",
    "description": "Tests du CRUD Appointment Service. Lancer avec le Collection Runner dans l'ordre (le dossier Erreurs utilise l'id créé dans le dossier CRUD).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CRUD",
      "item": [
        {
          "name": "1. Créer un rendez-vous (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments"
              ]
            },
            "description": "Crée un rendez-vous. Le statut initial est PENDING. L'id est mémorisé dans {{appointmentId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerId\": 1,\n  \"animalId\": 3,\n  \"vetId\": {{vetId}},\n  \"slotId\": {{slotId}},\n  \"motif\": \"Vaccination annuelle\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Créneau aléatoire pour pouvoir relancer la collection sans conflit",
                  "pm.collectionVariables.set(\"slotId\", Math.floor(Math.random() * 900000) + 100000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Statut = PENDING\", () => pm.expect(pm.response.json().statut).to.eql(\"PENDING\"));",
                  "const json = pm.response.json();",
                  "pm.test(\"Un id est généré\", () => pm.expect(json.id).to.be.a(\"number\"));",
                  "pm.test(\"En-tête Location présent\", () => pm.response.to.have.header(\"Location\"));",
                  "pm.collectionVariables.set(\"appointmentId\", json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Consulter par id (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "{{appointmentId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Bon id\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"appointmentId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Consulter par vétérinaire (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/appointments?vetId={{vetId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments"
              ],
              "query": [
                {
                  "key": "vetId",
                  "value": "{{vetId}}"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"Réponse = tableau\", () => pm.expect(list).to.be.an(\"array\"));",
                  "pm.test(\"Contient le rendez-vous créé\", () => pm.expect(list.map(a => a.id)).to.include(Number(pm.collectionVariables.get(\"appointmentId\"))));",
                  "pm.test(\"Tous du même vétérinaire\", () => list.forEach(a => pm.expect(a.vetId).to.eql(Number(pm.collectionVariables.get(\"vetId\")))));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Modifier le statut → CONFIRMED (200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Role",
                "value": "VET"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "{{appointmentId}}",
                "status"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"statut\": \"CONFIRMED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Statut = CONFIRMED\", () => pm.expect(pm.response.json().statut).to.eql(\"CONFIRMED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Annuler (200)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "{{appointmentId}}",
                "cancel"
              ]
            },
            "description": "Annulation logique : la ligne reste en base avec le statut CANCELLED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Statut = CANCELLED\", () => pm.expect(pm.response.json().statut).to.eql(\"CANCELLED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Toujours en base après annulation (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "{{appointmentId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Statut = CANCELLED\", () => pm.expect(pm.response.json().statut).to.eql(\"CANCELLED\"));"
                ]
              }
            }
          ]
        }
      ]
    },
